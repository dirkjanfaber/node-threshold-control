{
  "name": "node-threshold-control",
  "version": "0.2.2",
  "description": "Threshold control",
  "main": "dist/threshold-control.js",
  "files": [
    "dist/",
    "examples/"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && html-minifier-terser src/threshold-control.html -o dist/threshold-control.html --collapse-whitespace --remove-comments --minify-js true && cp -r src/icons dist/icons",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "node-red",
    "victron",
    "threshold control"
  ],
  "author": "Dirk-Jan Faber <dfaber@victronenergy.com>",
  "license": "MIT",
  "node-red": {
    "nodes": {
      "threshold-control": "dist/threshold-control.js"
    },
    "version": ">=3.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dirkjanfaber/node-threshold-control"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@types/node-red": "^1.3.5",
    "eslint": "^9.0.0",
    "globals": "^17.6.0",
    "html-minifier-terser": "^7.2.0",
    "jest": "^30.3.0",
    "neostandard": "^0.13.0",
    "node-red": "^4.1.10",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "node-red": ">=3.0.2"
  },
  "peerDependenciesMeta": {
    "node-red": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
